# Main
NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Security (required) — generate with: openssl rand -base64 48
SESSION_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# Programmatic invoice creation: send header X-API-Key with a store API key
# (created in Settings → API Keys). Session cookie still works for the dashboard.
# Temporarily accept pre-hash plaintext API keys from DB and upgrade them on use.
# Ignored in production (NODE_ENV=production). Prefer: yarn secrets:reencrypt + yarn secrets:audit-api-keys
ALLOW_LEGACY_PLAINTEXT_API_KEYS="false"

# Set to "true" to reject /api/user/create_user (invite-only / already provisioned hosts)
DISABLE_PUBLIC_REGISTRATION="false"
# Optional UI mirror (hides Register links/pages when true; keep in sync with DISABLE_PUBLIC_REGISTRATION)
NEXT_PUBLIC_DISABLE_PUBLIC_REGISTRATION="false"

# Optional: comma-separated allowed CORS / CSRF origins (full URLs, e.g. http://127.0.0.1:8888).
# Must match the browser Origin when logging in. localhost ≠ 127.0.0.1.
# Leave empty only for same-origin in development (production requires APP_BASE_URL).
CORS_ORIGIN=""

# Set true when behind a trusted reverse proxy that sets X-Forwarded-For.
# Leave false/unset so clients cannot spoof rate-limit keys via XFF.
TRUST_PROXY="false"

# Optional Redis for multi-instance rate limiting + cron locks (leave empty for in-memory / single node).
# Example: redis://127.0.0.1:6379/0
REDIS_URL=""
# Set true on multi-instance production so missing REDIS_URL fails validate:env / boot.
REQUIRE_REDIS="false"

# Force Secure cookies even outside NODE_ENV=production (also auto when APP_BASE_URL is https)
FORCE_SECURE_COOKIES="false"

# Use __Host-cps_session / __Host-cps_pending_2fa (requires HTTPS Secure cookies; no Domain attribute).
# Enable only on an HTTPS apex deployment after users can re-login.
USE_HOST_PREFIX_COOKIES="false"

# Public app URL used in password-reset emails (required — never derived from Host headers)
APP_BASE_URL="http://127.0.0.1:8888"

# Blockchain scan / faucet API (required for on-chain invoice settlement, faucet, address scan, tx history).
# Point at local node: http://127.0.0.1:7777/api  (docker: http://node-app:8080/api)
# Leave empty to disable — /api/health reports checks.blockscan=skipped and settlement soft-skips.
BLOCKSCAN_BASE_URL="http://127.0.0.1:7777/api"
# Must match node/config.yaml security.api-token (sent as X-API-Token)
BLOCKSCAN_API_TOKEN="local-dev-change-me"

# Schedule worker (run separately via `yarn worker` or docker-compose `worker`)
ENABLE_SCHEDULE_WORKER="true"
SCHEDULE_BASE_URL="http://127.0.0.1:8888/api/schedule/"

# Optional system SMTP for password reset (falls back to server log if unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# DB
DB_HOST=""
DB_PORT=""
DB_DATABASE=""
DB_USER=""
DB_PASSWORD=""
MYSQL_ROOT_PASSWORD=

# Coin Price — served by node /api/cryptoPrice via BLOCKSCAN_BASE_URL + BLOCKSCAN_API_TOKEN
# COINGECKO_AUTH is unused (kept for reference)
# COINGECKO_AUTH=""

# Tron
TRON_API_KEY_MAINNET=""
TRON_API_KEY_NILE=""

# Ton
TON_API_KEY=""

# Prisma
DATABASE_URL=""
